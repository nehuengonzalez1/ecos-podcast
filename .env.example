# ============================================================
#  ECOS · Historias que quedan — Variables de entorno
# ============================================================
# Todas van en Vercel Dashboard → Project Settings → Environment Variables
# (o localmente en .env.local que NO se commitea)

# --- Clerk (auth email + Google) ---
# 1) Instala vía Vercel Marketplace (Add Integration → Clerk) o creá app en clerk.com
# 2) Copiá las keys del dashboard de Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Mercado Pago (Preapproval / suscripciones) ---
# MP Dashboard → Tus aplicaciones → Crear aplicación (Suscripciones) → Credenciales
# Usa TEST_* para probar, APP_USR_* para producción real
MP_ACCESS_TOKEN=APP_USR_xxxx
MP_PREAPPROVAL_PLAN_ID=            # se genera con el script scripts/create-plan.mjs
MP_WEBHOOK_SECRET=cualquier-string-secreto
# Precio de la suscripción (ARS/mes)
NEXT_PUBLIC_SUBSCRIPTION_PRICE_ARS=1500

# --- Vercel KV (Upstash Redis, estado de suscripción) ---
# En Vercel: Storage → Create Database → KV → Attach al proyecto (auto-inyecta esto)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# --- Admin ---
# Emails autorizados a /admin (separados por coma)
ADMIN_EMAILS=tu@email.com

# --- Resend (avisos por email) ---
# Sin esto la app funciona igual, pero no salen los avisos de "Contá tu
# historia" ni los mensajes del muro hacia el protagonista.
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado, Resend solo deja usar su dominio
# de pruebas y enviar a la casilla dueña de la cuenta.
RESEND_FROM=
# A quién le llegan los mensajes de "Contá tu historia". Por defecto ADMIN_EMAILS.
CONTACT_NOTIFY_EMAILS=

# --- Muro de mensajes de cada episodio ---
# Quién recibe el aviso de que hay un mensaje esperando moderación.
# Por defecto CONTACT_NOTIFY_EMAILS y, si tampoco está, ADMIN_EMAILS.
MURO_NOTIFY_EMAILS=
# En 1 los mensajes se publican solos, sin pasar por el panel. Dejalo vacío
# salvo que quieras publicación directa: la moderación es lo que protege a la
# persona que contó su historia.
MURO_AUTO_APROBAR=

# --- App URL (base para webhooks y redirects MP) ---
NEXT_PUBLIC_APP_URL=https://lqlve.vercel.app
